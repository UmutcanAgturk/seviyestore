{
    "name": "seviye/sube-siparis",
    "description": "Seviye Commerce Platform - sube siparis kotasi (ucretsiz hak + Genel Merkez onayi + kart odemesi).",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "seviye/core": "*",
        "seviye/branches": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Seviye\\SubeSiparis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Seviye\\SubeSiparis\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../seviye-core"
        },
        {
            "type": "path",
            "url": "../seviye-branches"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
