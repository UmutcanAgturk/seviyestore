{
    "name": "seviye/core",
    "description": "Core framework for the Seviye Commerce Platform: DI container, event bus, RBAC, migration runner and shared infrastructure for every Seviye module.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Seviye\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Seviye\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
