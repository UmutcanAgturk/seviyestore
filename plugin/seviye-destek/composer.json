{
    "name": "seviye/destek",
    "description": "Seviye Commerce Platform - Veli destek/talep (helpdesk) sistemi: KVKK talebinden ayri, genel sikayet/soru bildirme ve sube personelinin yanitlayip kapatabilecegi bir ticket sistemi.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "seviye/core": "*",
        "seviye/branches": "*",
        "seviye/students": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Seviye\\Destek\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Seviye\\Destek\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../seviye-core"
        },
        {
            "type": "path",
            "url": "../seviye-branches"
        },
        {
            "type": "path",
            "url": "../seviye-students"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
