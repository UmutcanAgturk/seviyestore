{
    "name": "seviye/parents",
    "description": "Seviye Commerce Platform - Veli (guardian) profile fields not covered by wp_users: phone, notification preference, KVKK consent.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "seviye/core": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Seviye\\Parents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Seviye\\Parents\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../seviye-core"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
