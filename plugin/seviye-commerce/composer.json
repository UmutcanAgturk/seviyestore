{
    "name": "seviye/commerce",
    "description": "Seviye Commerce Platform - WooCommerce integration: student-scoped cart pricing, order flow, split payment.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "seviye/core": "*",
        "seviye/students": "*",
        "seviye/pricing": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Seviye\\Commerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Seviye\\Commerce\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../seviye-core"
        },
        {
            "type": "path",
            "url": "../seviye-branches"
        },
        {
            "type": "path",
            "url": "../seviye-students"
        },
        {
            "type": "path",
            "url": "../seviye-pricing"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
