{
    "name": "seviye/notifications",
    "description": "Seviye Commerce Platform - e-posta/SMS/panel-içi bildirim gönderimi.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "seviye/core": "*",
        "seviye/branches": "*",
        "seviye/students": "*",
        "seviye/parents": "*",
        "seviye/finance": "*",
        "seviye/depo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Seviye\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Seviye\\Notifications\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../seviye-core"
        },
        {
            "type": "path",
            "url": "../seviye-branches"
        },
        {
            "type": "path",
            "url": "../seviye-students"
        },
        {
            "type": "path",
            "url": "../seviye-parents"
        },
        {
            "type": "path",
            "url": "../seviye-finance"
        },
        {
            "type": "path",
            "url": "../seviye-depo"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
