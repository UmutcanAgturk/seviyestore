{
    "name": "seviye/security",
    "description": "Seviye Commerce Platform - authentication (T.C. Kimlik No login), rate-limited login protection, and single-use password/first-setup token issuance.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "seviye/core": "*",
        "seviye/branches": "*",
        "seviye/students": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Seviye\\Security\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Seviye\\Security\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../seviye-core"
        },
        {
            "type": "path",
            "url": "../seviye-branches"
        },
        {
            "type": "path",
            "url": "../seviye-students"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
