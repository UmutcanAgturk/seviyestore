{
    "name": "seviye/branches",
    "description": "Seviye Commerce Platform - branch (şube) management: entity, staff membership, IBAN/commission data.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "seviye/core": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Seviye\\Branches\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Seviye\\Branches\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../seviye-core"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
